{
  "name": "mono-dev",
  "version": "0.4.27",
  "description": "NPM module for mono-dev utilities",
  "type": "module",
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@prettier/cli": "^0.12.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/which": "^3.0.4",
    "rolldown": "^1.2.1",
    "which": "^7.0.0",
    "typedoc-theme-oxide": "^0.3.0",
    "eslint-plugin-react-compiler": "0.0.0-experimental-6cef588-20250815"
  },
  "bin": {
    "vite": "./bin/vite.js",
    "vitest": "./bin/vitest.js",
    "eslint": "./bin/eslint.js",
    "tsc": "./bin/tsc.js",
    "mono": "./bin/mono.js"
  },
  "files": [
    "bin/**/*",
    "dist/**/*",
    "lib/**/*",
    "mdbook/**/*",
    "scripts/**/*",
    "src/**/*",
    "task/**/*",
    "toolsets/**/*",
    "types/**/*",
    "dist/**/*"
  ],
  "exports": {
    "./vite": "./lib/vite.js",
    "./vitest": "./lib/vitest.js",
    "./lib-types": "./types/lib_types.d.ts",
    "./app-types": "./types/app_types.d.ts",
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/_dts_/src/cli/index.d.ts"
    },
    "./eslint-config": {
      "import": "./dist/config/configure_eslint.js",
      "types": "./dist/_dts_/src/config/configure_eslint.d.ts"
    },
    "./lib-build-config": {
      "import": "./dist/config/configure_lib_build.js",
      "types": "./dist/_dts_/src/config/configure_lib_build.d.ts"
    },
    "./app-build-config": {
      "import": "./dist/config/configure_app_build.js",
      "types": "./dist/_dts_/src/config/configure_app_build.d.ts"
    },
    "./rolldown": {
      "import": "./dist/rolldown.js",
      "types": "./dist/_dts_/src/rolldown.d.ts"
    }
  },
  "imports": {
    "#cli": "./dist/_dts_/src/cli/index.d.ts",
    "#config": "./dist/_dts_/src/config/index.d.ts",
    "#plugins": "./dist/_dts_/src/plugins/index.d.ts",
    "#project": "./dist/_dts_/src/project/index.d.ts",
    "#util": "./dist/_dts_/src/util/index.d.ts"
  }
}